{
  "name": "pokeflip-studio-android",
  "version": "4.3.0",
  "private": true,
  "description": "Capacitor Android wrapper for the PokéFlip Studio web app (kept out of the web package so the website stays dependency-free).",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync android",
    "test": "node --test tests/*.test.mjs",
    "apk:debug": "npm run sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@supabase/supabase-js": "2.119.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  }
}
